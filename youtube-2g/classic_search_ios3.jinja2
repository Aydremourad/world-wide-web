<?xml version='1.0' encoding='UTF-8'?>
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:gd="http://schemas.google.com/g/2005"
      xmlns:openSearch="http://a9.com/-/spec/opensearch/1.1/"
      xmlns:yt="http://gdata.youtube.com/schemas/2007"
      xmlns:media="http://search.yahoo.com/mrss/">
  <id>{{url}}/feeds/api/videos/</id>
  <category scheme="http://schemas.google.com/g/2005#kind"
            term="http://gdata.youtube.com/schemas/2007#video"/>
  <title>Search Results</title>
  <link rel="http://schemas.google.com/g/2005#feed"
        type="application/atom+xml"
        href="{{url}}/feeds/api/videos/"/>
  <link rel="http://schemas.google.com/g/2005#batch"
        type="application/atom+xml"
        href="{{url}}/feeds/api/videos/batch"/>
  <link rel="self"
        type="application/atom+xml"
        href="{{url}}/feeds/api/videos/"/>
  {% if next_page %}
  <link rel="next"
        type="application/atom+xml"
        href="{{next_page}}"/>
  {% endif %}
  <author>
    <name>YouTube</name>
    <uri>{{url}}/</uri>
  </author>
  <generator version="2.0" uri="{{url}}/">YouTube data API</generator>
  <openSearch:totalResults>{{ data | length }}</openSearch:totalResults>
  <openSearch:itemsPerPage>{{ data | length }}</openSearch:itemsPerPage>
  <openSearch:startIndex>1</openSearch:startIndex>

{% for info in data %}
  <entry>
    <id>tag:youtube.com,2008:video:{{info['videoId']}}</id>
    <published>{{unix(info['published'])}}</published>
    <updated>{{unix(info['published'])}}</updated>
    <category scheme="http://schemas.google.com/g/2005#kind"
              term="http://gdata.youtube.com/schemas/2007#video"/>
    <category scheme="http://gdata.youtube.com/schemas/2007/categories.cat"
              term="Music" label="Music"/>
    <title>{{info['title']}}</title>
    <content type="video/mp4"
             src="{{url}}/getvideo/{{info['videoId']}}"/>
    <summary type="text">{{info['description']}}</summary>

    <link rel="alternate"
          type="video/mp4"
          href="{{url}}/getvideo/{{info['videoId']}}"/>
    <link rel="http://gdata.youtube.com/schemas/2007#video.related"
          type="application/atom+xml"
          href="{{url}}/feeds/api/videos/{{info['videoId']}}/related"/>
    <link rel="http://gdata.youtube.com/schemas/2007#mobile"
          type="video/mp4"
          href="{{url}}/getvideo/{{info['videoId']}}"/>
    {% if info['authorId'] != "unknown" and info['authorId'] != "Unknown" %}
    <link rel="http://gdata.youtube.com/schemas/2007#uploader"
          type="application/atom+xml"
          href="{{url}}/feeds/api/users/{{info['authorId']}}/uploads"/>
    {% endif %}
    <link rel="self"
          type="application/atom+xml"
          href="{{url}}/feeds/api/videos/{{info['videoId']}}"/>

    <author>
      <name>{{info['author']}}</name>
      <uri>{{url}}/feeds/api/users/{{info['authorId']}}</uri>
      <yt:userId>{{info['authorId']}}</yt:userId>
    </author>

    <yt:accessControl action="comment" permission="allowed"/>
    <yt:accessControl action="rate" permission="allowed"/>
    <yt:accessControl action="embed" permission="allowed"/>
    <yt:accessControl action="list" permission="allowed"/>
    <yt:accessControl action="autoPlay" permission="allowed"/>
    <yt:accessControl action="syndicate" permission="allowed"/>

    <gd:comments>
      <gd:feedLink href="{{url}}/api/videos/{{info['videoId']}}/comments"/>
    </gd:comments>
    <yt:statistics favoriteCount="0"
                   viewCount="{{ [info['viewCount'], 2147483647] | min }}"/>

    <media:group>
      <media:category label="Music"
                      scheme="http://gdata.youtube.com/schemas/2007/categories.cat">Music</media:category>
      <media:content url="{{url}}/getvideo/{{info['videoId']}}"
                     type="video/mp4"
                     medium="video"
                     isDefault="true"
                     expression="full"
                     duration="{{info['lengthSeconds']}}"
                     yt:format="3"/>
      <media:content url="{{url}}/getvideo/{{info['videoId']}}"
                     type="video/mp4"
                     medium="video"
                     expression="full"
                     duration="{{info['lengthSeconds']}}"
                     yt:format="2"/>
      <media:credit role="uploader"
                    scheme="urn:youtube"
                    yt:display="{{info['author']}}">{{info['author']}}</media:credit>
      <media:description type="plain">{{info['description']}}</media:description>
      <media:keywords></media:keywords>
      <media:player url="{{url}}/getvideo/{{info['videoId']}}"/>
      <media:thumbnail url="{{url}}/thumb/{{info['videoId']}}"
                       height="90"
                       width="120"
                       yt:name="default"/>
      <media:title type="plain">{{info['title']}}</media:title>
      <yt:duration seconds="{{info['lengthSeconds']}}"/>
      <yt:uploaded>{{unix(info['published'])}}</yt:uploaded>
      <yt:uploaderId>{{info['authorId']}}</yt:uploaderId>
      <yt:videoid>{{info['videoId']}}</yt:videoid>
    </media:group>
  </entry>
{% endfor %}
</feed>
