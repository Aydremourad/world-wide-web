# Generate COMPANION_SECRET_KEY with:
#   openssl rand -hex 8
# It must be exactly 16 characters.
COMPANION_SECRET_KEY=

# OCI-assigned IPv6 address for this VM, as a single-address /128.
COMPANION_IPV6_BLOCK=

# Keep the same Google OAuth credentials used by the sign-in-working
# Modified TubeRepair deployment. Leave blank for the first playback-only test.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
